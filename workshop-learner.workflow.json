    {"id":"exercise","lane":"practice","col":2,"type":"backend","label":"Try it","width":120,"sublabel":"Cursor + Hearthline"},
    {"id":"verify","lane":"practice","col":3,"type":"security","label":"Check it","width":120,"sublabel":"Tests + expected diff"},
    {"id":"record","lane":"continuity","col":4,"type":"frontend","label":"Mark done","width":120,"sublabel":"Explicit self-report"},
